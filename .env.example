# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to client
PUBLIC_SUPABASE_ANON_KEY=your-anon-key            # safe for client, if we need client-side reads later

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx           # server-side only, used for verify-payment
PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx     # safe for client, used to open the checkout popup
