# Supabase
SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # same URL, exposed to the browser for the admin login
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx   # server-side only, never expose to client
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx   # safe for client, used for the admin login

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx           # server-side only, used for verify-payment
PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx     # safe for client, used to open the checkout popup

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev