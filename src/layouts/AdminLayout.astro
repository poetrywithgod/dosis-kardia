---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#2B2318" />
    <link rel="manifest" href="/admin-manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/admin-icon-192.png" />
    <link rel="apple-touch-icon" href="/admin-icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · DK Admin</title>
  </head>
  <body class="bg-ivory text-ink font-body antialiased min-h-screen">
    <slot />

    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/admin-sw.js').catch(() => {
          // Non-fatal: the dashboard still works without offline support
        });
      }
    </script>
  </body>
</html>
