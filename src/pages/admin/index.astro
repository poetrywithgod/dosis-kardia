---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Mail, HandCoins, LogOut, Bell, Settings } from '@lucide/astro';
---

<AdminLayout title="Dashboard">
  <div class="min-h-screen bg-ivory">
    <!-- Auth guard placeholder shown until the session check resolves -->
    <div id="auth-checking" class="min-h-screen flex items-center justify-center text-ink/40 text-sm">
      Checking session…
    </div>

    <div id="dashboard" class="hidden min-h-screen pb-24">
      <!-- Top bar -->
      <header class="sticky top-0 z-20 bg-ivory/95 backdrop-blur-sm border-b border-umber/10 px-4 py-3 flex items-center justify-between">
        <img src="/logo.png" alt="" class="h-8 w-auto" />
        <div class="flex items-center gap-4">
          <div class="relative">
            <Bell size={20} class="text-umber/60" />
            <span
              id="header-badge"
              class="hidden absolute -top-1.5 -right-1.5 bg-clay text-ivory text-[10px] font-bold min-w-[16px] h-4 rounded-full flex items-center justify-center px-1"
            >0</span>
          </div>
          <button id="signout-btn" class="text-ink/40 hover:text-clay transition-colors" aria-label="Sign out">
            <LogOut size={20} />
          </button>
        </div>
      </header>

      <!-- Tabs -->
      <div class="flex gap-1 mx-4 mt-4 p-1 bg-umber/5 rounded-full">
        <button
          class="tab-btn flex-1 flex items-center justify-center gap-2 py-2 rounded-full text-sm font-semibold text-ink/50 transition-all"
          data-tab="messages"
        >
          <Mail size={16} />
          Messages
          <span id="messages-count-badge" class="hidden bg-clay text-ivory text-[10px] font-bold min-w-[16px] h-4 rounded-full flex items-center justify-center px-1">0</span>
        </button>
        <button
          class="tab-btn flex-1 flex items-center justify-center gap-2 py-2 rounded-full text-sm font-semibold text-ink/50 transition-all"
          data-tab="donations"
        >
          <HandCoins size={16} />
          Donations
          <span id="donations-count-badge" class="hidden bg-clay text-ivory text-[10px] font-bold min-w-[16px] h-4 rounded-full flex items-center justify-center px-1">0</span>
        </button>
        <button
          class="tab-btn flex-1 flex items-center justify-center gap-2 py-2 rounded-full text-sm font-semibold text-ink/50 transition-all"
          data-tab="settings"
        >
          <Settings size={16} />
          Settings
        </button>
      </div>

      <!-- Lists -->
      <main class="px-4 pt-4 space-y-3">
        <div id="messages-panel" class="space-y-3"></div>
        <div id="donations-panel" class="space-y-3 hidden"></div>
        <div id="settings-panel" class="space-y-4 hidden">
          <div class="bg-white border border-umber/10 rounded-2xl p-4 shadow-[0_1px_2px_rgba(43,35,24,0.04)]">
            <h2 class="font-semibold text-umber text-sm mb-1">Invite an admin</h2>
            <p class="text-xs text-ink/40 mb-3">They'll get an email with a link to set their own password.</p>
            <form id="invite-form" class="flex gap-2">
              <input
                id="invite-email" type="email" required placeholder="name@example.com"
                class="flex-1 min-w-0 rounded-xl border border-umber/15 px-3 py-2.5 text-sm text-ink placeholder:text-ink/30 focus:outline-none focus:ring-2 focus:ring-clay/40 focus:border-transparent"
              />
              <button
                id="invite-submit" type="submit"
                class="shrink-0 bg-clay text-ivory px-4 py-2.5 rounded-xl text-sm font-semibold hover:opacity-90 transition-opacity disabled:opacity-50"
              >Invite</button>
            </form>
            <p id="invite-status" class="text-xs min-h-4 mt-2"></p>
          </div>
          <div>
            <h2 class="font-semibold text-umber text-sm mb-2 px-1">Admins</h2>
            <div id="admins-list" class="space-y-2">
              <p class="text-center text-sm text-ink/30 py-6">Loading…</p>
            </div>
          </div>
        </div>
        <p id="empty-state" class="hidden text-center text-sm text-ink/30 py-12">Nothing here yet.</p>
      </main>
    </div>
  </div>

  <style>
    .tab-btn.active {
      background: #FFFFFF;
      color: #2B2318;
      box-shadow: 0 1px 3px rgba(43,35,24,0.08), 0 1px 2px rgba(43,35,24,0.04);
    }
  </style>

  <script>
    import { supabaseBrowser } from '../../lib/supabaseClient';

    type ContactMessage = {
      id: string;
      name: string;
      email: string;
      message: string;
      created_at: string;
    };
    type MessageReply = {
      id: string;
      message_id: string;
      body: string;
      sent_at: string;
    };
    type Donation = {
      id: string;
      reference: string;
      donor_name: string | null;
      donor_email: string | null;
      amount_naira: number;
      currency: string;
      paystack_status: string;
      created_at: string;
    };
    type Admin = {
      id: string;
      email: string;
      created_at: string;
      last_sign_in_at: string | null;
    };

    const authChecking = document.getElementById('auth-checking')!;
    const dashboard = document.getElementById('dashboard')!;
    const messagesPanel = document.getElementById('messages-panel')!;
    const donationsPanel = document.getElementById('donations-panel')!;
    const settingsPanel = document.getElementById('settings-panel')!;
    const adminsList = document.getElementById('admins-list')!;
    const inviteForm = document.getElementById('invite-form') as HTMLFormElement;
    const inviteEmail = document.getElementById('invite-email') as HTMLInputElement;
    const inviteSubmit = document.getElementById('invite-submit') as HTMLButtonElement;
    const inviteStatus = document.getElementById('invite-status')!;
    const emptyState = document.getElementById('empty-state')!;
    const headerBadge = document.getElementById('header-badge')!;
    const messagesCountBadge = document.getElementById('messages-count-badge')!;
    const donationsCountBadge = document.getElementById('donations-count-badge')!;

    let unseenMessages = 0;
    let unseenDonations = 0;
    let activeTab: 'messages' | 'donations' | 'settings' = 'messages';
    let currentUserId: string | null = null;
    let adminsLoaded = false;

    const fmtDate = (iso: string) =>
      new Date(iso).toLocaleString('en-NG', { dateStyle: 'medium', timeStyle: 'short' });

    const fmtNaira = (n: number) =>
      new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN', maximumFractionDigits: 0 }).format(n);

    function updateBadges() {
      const total = unseenMessages + unseenDonations;
      if (total > 0) {
        headerBadge.textContent = String(total);
        headerBadge.classList.remove('hidden');
      } else {
        headerBadge.classList.add('hidden');
      }

      if (unseenMessages > 0) {
        messagesCountBadge.textContent = `+${unseenMessages}`;
        messagesCountBadge.classList.remove('hidden');
      } else {
        messagesCountBadge.classList.add('hidden');
      }

      if (unseenDonations > 0) {
        donationsCountBadge.textContent = `+${unseenDonations}`;
        donationsCountBadge.classList.remove('hidden');
      } else {
        donationsCountBadge.classList.add('hidden');
      }

      if ('setAppBadge' in navigator) {
        if (total > 0) (navigator as any).setAppBadge(total);
        else (navigator as any).clearAppBadge();
      }
    }

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    const AVATAR_COLORS = ['#C1481D', '#4A5D45', '#2B6CB0', '#805AD5', '#B7791F', '#B83280'];

    // Default avatar for a contact — an initials circle, colored
    // deterministically from their name so the same person always gets the
    // same color across the dashboard.
    function contactAvatar(name: string) {
      const initial = (name || '?').trim().charAt(0).toUpperCase() || '?';
      let hash = 0;
      for (const ch of name || '') hash += ch.charCodeAt(0);
      const color = AVATAR_COLORS[hash % AVATAR_COLORS.length];
      return `<div class="w-8 h-8 rounded-full flex items-center justify-center text-ivory text-xs font-bold shrink-0" style="background:${color}">${escapeHtml(initial)}</div>`;
    }

    // Admin avatar is always the site logo, so replies are instantly
    // recognizable in the thread.
    function adminAvatar() {
      return `<img src="/logo.png" alt="" class="w-8 h-8 rounded-full object-cover shrink-0 bg-white border border-umber/10" />`;
    }

    function renderReplyBubble(r: MessageReply) {
      return `
        <div class="flex items-start gap-2 justify-end" data-reply-id="${escapeHtml(r.id)}">
          <div class="max-w-[80%]">
            <div class="bg-clay text-ivory rounded-2xl rounded-tr-sm px-3 py-2 text-sm leading-relaxed whitespace-pre-wrap">${escapeHtml(r.body)}</div>
            <p class="text-[10px] text-ink/35 mt-1 text-right">${fmtDate(r.sent_at)}</p>
          </div>
          ${adminAvatar()}
        </div>
      `;
    }

    function renderMessage(m: ContactMessage, replies: MessageReply[] = []) {
      const el = document.createElement('div');
      el.className = 'bg-white border border-umber/10 rounded-2xl p-4 shadow-[0_1px_2px_rgba(43,35,24,0.04)]';
      el.dataset.id = m.id;
      el.innerHTML = `
        <div class="flex items-start justify-between gap-3 mb-1.5">
          <p class="font-semibold text-umber text-sm">${escapeHtml(m.name)}</p>
          <p class="text-xs text-ink/35 shrink-0">${fmtDate(m.created_at)}</p>
        </div>
        <p class="text-xs text-clay mb-2">${escapeHtml(m.email)}</p>
        <div class="message-thread space-y-3 mb-3">
          <div class="flex items-start gap-2">
            ${contactAvatar(m.name)}
            <div class="max-w-[80%] bg-ivory rounded-2xl rounded-tl-sm px-3 py-2 text-sm text-ink/70 leading-relaxed whitespace-pre-wrap">${escapeHtml(m.message)}</div>
          </div>
          ${replies.map(renderReplyBubble).join('')}
        </div>
        <div class="flex items-center gap-2 reply-controls">
          <button class="reply-btn flex items-center gap-1.5 text-xs font-semibold text-clay hover:bg-clay hover:text-ivory transition-colors px-3 py-1.5 rounded-full border border-clay/30">
            <span class="reply-icon"></span> Reply
          </button>
          <button class="delete-btn flex items-center gap-1.5 text-xs font-semibold text-ink/40 hover:bg-[#C1481D] hover:text-ivory hover:border-[#C1481D] transition-colors px-3 py-1.5 rounded-full border border-umber/15">
            <span class="delete-icon"></span> Delete
          </button>
        </div>
        <div class="reply-box hidden mt-3 space-y-2">
          <textarea rows="3" placeholder="Write your reply…" class="reply-textarea w-full rounded-lg border border-umber/15 bg-ivory/60 px-3 py-2 text-sm text-umber placeholder:text-umber/30 focus:outline-none focus:ring-2 focus:ring-clay/40"></textarea>
          <div class="flex items-center gap-2">
            <button class="send-reply-btn flex items-center gap-1.5 text-xs font-semibold bg-clay text-ivory px-3 py-1.5 rounded-full hover:bg-umber transition-colors">
              <span class="send-icon"></span> Send
            </button>
            <button class="cancel-reply-btn flex items-center gap-1.5 text-xs font-semibold text-ink/40 hover:text-umber px-3 py-1.5 transition-colors">
              Cancel
            </button>
            <p class="reply-status text-xs min-h-4"></p>
          </div>
        </div>
      `;

      el.querySelector('.reply-icon')!.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>';
      el.querySelector('.delete-icon')!.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>';
      el.querySelector('.send-icon')!.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';

      const thread = el.querySelector('.message-thread')!;
      const replyBtn = el.querySelector('.reply-btn')!;
      const cancelBtn = el.querySelector('.cancel-reply-btn')!;
      const sendBtn = el.querySelector('.send-reply-btn') as HTMLButtonElement;
      const replyBox = el.querySelector('.reply-box')!;
      const replyControls = el.querySelector('.reply-controls')!;
      const textarea = el.querySelector('.reply-textarea') as HTMLTextAreaElement;
      const replyStatus = el.querySelector('.reply-status') as HTMLElement;
      const deleteBtn = el.querySelector('.delete-btn') as HTMLButtonElement;

      replyBtn.addEventListener('click', () => {
        replyControls.classList.add('hidden');
        replyBox.classList.remove('hidden');
        textarea.focus();
      });

      cancelBtn.addEventListener('click', () => {
        replyBox.classList.add('hidden');
        replyControls.classList.remove('hidden');
        textarea.value = '';
        replyStatus.textContent = '';
      });

      let isSending = false;
      sendBtn.addEventListener('click', async () => {
        const replyBody = textarea.value.trim();
        if (!replyBody || isSending) return;
        isSending = true;
        sendBtn.disabled = true;
        replyStatus.textContent = 'Sending…';
        replyStatus.className = 'reply-status text-xs min-h-4 text-ink/40';

        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const token = sessionData.session?.access_token;

        try {
          const res = await fetch('/api/reply-message', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ messageId: m.id, replyBody }),
          });
          const result = await res.json();
          if (result.success) {
            replyStatus.textContent = 'Sent!';
            replyStatus.className = 'reply-status text-xs min-h-4 text-[#4A5D45]';
            // Show the reply in the conversation thread immediately so the
            // admin can follow the back-and-forth without reloading.
            if (result.reply) {
              thread.insertAdjacentHTML('beforeend', renderReplyBubble(result.reply as MessageReply));
            }
            setTimeout(() => cancelBtn.dispatchEvent(new Event('click')), 1200);
          } else {
            replyStatus.textContent = result.error || 'Failed to send.';
            replyStatus.className = 'reply-status text-xs min-h-4 text-[#C1481D]';
          }
        } catch {
          replyStatus.textContent = 'Failed to send.';
          replyStatus.className = 'reply-status text-xs min-h-4 text-[#C1481D]';
        } finally {
          sendBtn.disabled = false;
          isSending = false;
        }
      });

      deleteBtn.addEventListener('click', async () => {
        if (!confirm('Delete this message? This cannot be undone.')) return;
        deleteBtn.disabled = true;
        const { error } = await supabaseBrowser.from('contact_messages').delete().eq('id', m.id);
        if (error) {
          alert('Could not delete this message. Try again.');
          deleteBtn.disabled = false;
          return;
        }
        el.classList.add('card-leaving');
        setTimeout(() => el.remove(), 250);
      });

      return el;
    }

    function renderDonation(d: Donation) {
      const el = document.createElement('div');
      el.className = 'bg-white border border-umber/10 rounded-2xl p-4 shadow-[0_1px_2px_rgba(43,35,24,0.04)]';
      const statusColor = d.paystack_status === 'success' ? 'text-[#4A5D45]' : 'text-[#C1481D]';
      el.innerHTML = `
        <div class="flex items-start justify-between gap-3 mb-1.5">
          <p class="font-admin-display text-lg text-umber">${fmtNaira(d.amount_naira)}</p>
          <p class="text-xs text-ink/35 shrink-0">${fmtDate(d.created_at)}</p>
        </div>
        <p class="text-sm text-ink/70">${escapeHtml(d.donor_name || 'Anonymous')} — ${escapeHtml(d.donor_email || '')}</p>
        <p class="text-xs ${statusColor} mt-1 font-medium">${escapeHtml(d.paystack_status)} · ${escapeHtml(d.reference)}</p>
      `;
      return el;
    }

    function setActiveTab(tab: 'messages' | 'donations' | 'settings') {
      activeTab = tab;
      document.querySelectorAll('.tab-btn').forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.tab === tab;
        btn.classList.toggle('active', isActive);
      });
      messagesPanel.classList.toggle('hidden', tab !== 'messages');
      donationsPanel.classList.toggle('hidden', tab !== 'donations');
      settingsPanel.classList.toggle('hidden', tab !== 'settings');
      if (tab === 'settings') emptyState.classList.add('hidden');

      if (tab === 'messages') unseenMessages = 0;
      if (tab === 'donations') unseenDonations = 0;
      if (tab === 'settings' && !adminsLoaded) loadAdmins();
      updateBadges();
    }

    document.querySelectorAll('.tab-btn').forEach((btn) => {
      btn.addEventListener('click', () =>
        setActiveTab((btn as HTMLElement).dataset.tab as 'messages' | 'donations' | 'settings')
      );
    });

    function renderAdminRow(a: Admin) {
      const el = document.createElement('div');
      el.className = 'bg-white border border-umber/10 rounded-2xl p-3.5 flex items-center justify-between gap-3';
      el.dataset.adminId = a.id;
      const isYou = a.id === currentUserId;
      const statusLabel = a.last_sign_in_at ? `Last signed in ${fmtDate(a.last_sign_in_at)}` : 'Invited · not signed in yet';
      el.innerHTML = `
        <div class="min-w-0">
          <p class="text-sm font-medium text-ink truncate">${escapeHtml(a.email)}${isYou ? ' <span class="text-ink/35 font-normal">(you)</span>' : ''}</p>
          <p class="text-xs text-ink/40 mt-0.5">${escapeHtml(statusLabel)}</p>
        </div>
        ${isYou ? '' : '<button class="remove-admin-btn shrink-0 text-xs font-semibold text-[#C1481D] hover:opacity-70 transition-opacity">Remove</button>'}
      `;

      const removeBtn = el.querySelector('.remove-admin-btn');
      removeBtn?.addEventListener('click', async () => {
        if (!confirm(`Remove ${a.email} as an admin? They will lose access immediately.`)) return;
        (removeBtn as HTMLButtonElement).disabled = true;
        const { data: sessionData } = await supabaseBrowser.auth.getSession();
        const token = sessionData.session?.access_token;
        try {
          const res = await fetch('/api/remove-admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
            body: JSON.stringify({ adminId: a.id }),
          });
          const result = await res.json();
          if (result.success) {
            el.remove();
          } else {
            alert(result.error || 'Could not remove this admin.');
            (removeBtn as HTMLButtonElement).disabled = false;
          }
        } catch {
          alert('Could not remove this admin. Try again.');
          (removeBtn as HTMLButtonElement).disabled = false;
        }
      });

      return el;
    }

    async function loadAdmins() {
      adminsLoaded = true;
      const { data: sessionData } = await supabaseBrowser.auth.getSession();
      const token = sessionData.session?.access_token;
      try {
        const res = await fetch('/api/list-admins', { headers: { Authorization: `Bearer ${token}` } });
        const result = await res.json();
        adminsList.innerHTML = '';
        if (!result.success) {
          adminsList.innerHTML = `<p class="text-center text-sm text-ink/30 py-6">${escapeHtml(result.error || 'Could not load admins.')}</p>`;
          return;
        }
        currentUserId = result.currentUserId;
        (result.admins as Admin[]).forEach((a) => adminsList.appendChild(renderAdminRow(a)));
      } catch {
        adminsList.innerHTML = '<p class="text-center text-sm text-ink/30 py-6">Could not load admins.</p>';
      }
    }

    inviteForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = inviteEmail.value.trim();
      if (!email) return;
      inviteSubmit.disabled = true;
      inviteStatus.textContent = 'Sending invite…';
      inviteStatus.className = 'text-xs min-h-4 mt-2 text-ink/40';

      const { data: sessionData } = await supabaseBrowser.auth.getSession();
      const token = sessionData.session?.access_token;

      try {
        const res = await fetch('/api/create-admin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ email }),
        });
        const result = await res.json();
        if (result.success) {
          inviteStatus.textContent = `Invite sent to ${email}.`;
          inviteStatus.className = 'text-xs min-h-4 mt-2 text-[#4A5D45]';
          inviteEmail.value = '';
          if (result.admin) adminsList.prepend(renderAdminRow(result.admin as Admin));
        } else {
          inviteStatus.textContent = result.error || 'Could not send invite.';
          inviteStatus.className = 'text-xs min-h-4 mt-2 text-[#C1481D]';
        }
      } catch {
        inviteStatus.textContent = 'Could not send invite. Try again.';
        inviteStatus.className = 'text-xs min-h-4 mt-2 text-[#C1481D]';
      } finally {
        inviteSubmit.disabled = false;
      }
    });

    async function loadData() {
      const [{ data: messages, error: mErr }, { data: donations, error: dErr }, { data: replies, error: rErr }] =
        await Promise.all([
          supabaseBrowser.from('contact_messages').select('*').order('created_at', { ascending: false }),
          supabaseBrowser.from('donations').select('*').order('created_at', { ascending: false }),
          supabaseBrowser.from('message_replies').select('*').order('sent_at', { ascending: true }),
        ]);

      messagesPanel.innerHTML = '';
      donationsPanel.innerHTML = '';

      if (mErr || dErr || rErr) {
        emptyState.textContent = 'Could not load data. Check your connection and try again.';
        emptyState.classList.remove('hidden');
        return;
      }

      const repliesByMessage = new Map<string, MessageReply[]>();
      (replies ?? []).forEach((r) => {
        const list = repliesByMessage.get(r.message_id) ?? [];
        list.push(r as MessageReply);
        repliesByMessage.set(r.message_id, list);
      });

      (messages ?? []).forEach((m) =>
        messagesPanel.appendChild(renderMessage(m as ContactMessage, repliesByMessage.get(m.id) ?? []))
      );
      (donations ?? []).forEach((d) => donationsPanel.appendChild(renderDonation(d as Donation)));

      if ((messages ?? []).length === 0 && activeTab === 'messages') {
        emptyState.classList.remove('hidden');
      }
    }

    function subscribeRealtime() {
      supabaseBrowser
        .channel('admin-contact-messages')
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'contact_messages' }, (payload) => {
          const incoming = payload.new as ContactMessage;
          // Guard against rendering the same message twice — e.g. if it was
          // already picked up by the initial loadData() fetch and also
          // arrives here via the realtime channel. A duplicate card would
          // mean a duplicate, independently-clickable Send button.
          if (messagesPanel.querySelector(`[data-id="${incoming.id}"]`)) return;
          messagesPanel.prepend(renderMessage(incoming));
          if (activeTab !== 'messages') {
            unseenMessages += 1;
            updateBadges();
          }
        })
        .subscribe();

      supabaseBrowser
        .channel('admin-message-replies')
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'message_replies' }, (payload) => {
          const incoming = payload.new as MessageReply;
          const card = messagesPanel.querySelector(`[data-id="${incoming.message_id}"]`);
          const thread = card?.querySelector('.message-thread');
          if (!thread) return;
          // Skip if this exact reply is already in the thread — it will be
          // if the reply was just sent from this same session, since the
          // send handler already appended it locally.
          if (thread.querySelector(`[data-reply-id="${incoming.id}"]`)) return;
          thread.insertAdjacentHTML('beforeend', renderReplyBubble(incoming));
        })
        .subscribe();

      supabaseBrowser
        .channel('admin-donations')
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'donations' }, (payload) => {
          donationsPanel.prepend(renderDonation(payload.new as Donation));
          if (activeTab !== 'donations') {
            unseenDonations += 1;
            updateBadges();
          }
        })
        .subscribe();
    }

    document.getElementById('signout-btn')?.addEventListener('click', async () => {
      await supabaseBrowser.auth.signOut();
      window.location.href = '/admin/login';
    });

    supabaseBrowser.auth.getSession().then(async ({ data }) => {
      if (!data.session) {
        window.location.href = '/admin/login';
        return;
      }
      authChecking.classList.add('hidden');
      dashboard.classList.remove('hidden');
      setActiveTab('messages');
      await loadData();
      subscribeRealtime();
    });
  </script>
</AdminLayout>
