---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Lock, Eye, EyeOff } from '@lucide/astro';
---

<AdminLayout title="Reset password">
  <div class="relative min-h-screen flex items-center justify-center px-6 overflow-hidden bg-umber">
    <div class="glow glow-1" aria-hidden="true"></div>
    <div class="glow glow-2" aria-hidden="true"></div>

    <div class="relative w-full max-w-sm">
      <div class="text-center mb-8">
        <div class="inline-block bg-ivory rounded-2xl px-6 py-4 shadow-[0_8px_30px_-6px_rgba(0,0,0,0.4)] mb-5">
          <img src="/logo.png" alt="Dosis Kardia Foundation" class="h-12 w-auto mx-auto" />
        </div>
        <h1 class="font-admin-display text-2xl text-ivory font-semibold">Set a new password</h1>
      </div>

      <div id="loading-state" class="text-center text-ivory/50 text-sm">
        Verifying reset link…
      </div>

      <form
        id="reset-form"
        class="hidden relative bg-ivory/10 backdrop-blur-2xl border border-ivory/20 rounded-3xl p-7 space-y-5 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.5)]"
      >
        <div>
          <label for="new-password" class="block text-xs font-medium text-ivory/70 mb-2 tracking-wide uppercase">New password</label>
          <div class="relative">
            <Lock size={18} class="absolute left-4 top-1/2 -translate-y-1/2 text-ivory/40" />
            <input
              id="new-password" name="new-password" type="password" required minlength="6" autocomplete="new-password"
              class="w-full rounded-xl border border-ivory/15 bg-ivory/5 pl-11 pr-11 py-3.5 text-ivory placeholder:text-ivory/30 focus:outline-none focus:ring-2 focus:ring-marigold focus:border-transparent transition-all text-base"
              placeholder="At least 6 characters"
            />
            <button
              type="button" id="toggle-password"
              class="absolute right-3.5 top-1/2 -translate-y-1/2 text-ivory/40 hover:text-ivory transition-colors"
              aria-label="Show password"
            >
              <Eye size={18} id="eye-icon" />
              <EyeOff size={18} id="eye-off-icon" class="hidden" />
            </button>
          </div>
        </div>
        <button
          type="submit" id="reset-submit"
          class="w-full bg-marigold text-umber py-3.5 rounded-xl font-semibold hover:bg-ivory transition-all duration-300 disabled:opacity-50"
        >
          Update password
        </button>
        <p id="reset-status" class="text-sm text-center min-h-5" aria-live="polite"></p>
      </form>

      <div id="invalid-link" class="hidden text-center bg-ivory/10 backdrop-blur-2xl border border-ivory/20 rounded-3xl p-7">
        <p class="text-ivory/70 text-sm mb-4">
          This reset link is invalid or has expired.
        </p>
        <a href="/admin/login" class="text-marigold hover:text-ivory transition-colors text-sm font-semibold">
          ← Back to sign in
        </a>
      </div>
    </div>
  </div>

  <style>
    .glow {
      position: absolute;
      border-radius: 9999px;
      filter: blur(80px);
      opacity: 0.35;
      pointer-events: none;
    }
    .glow-1 {
      width: 420px; height: 420px; background: #F2A93B;
      top: -10%; left: -10%; animation: drift1 14s ease-in-out infinite;
    }
    .glow-2 {
      width: 380px; height: 380px; background: #C1481D;
      bottom: -15%; right: -10%; animation: drift2 16s ease-in-out infinite;
    }
    @keyframes drift1 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(30px, 40px) scale(1.1); }
    }
    @keyframes drift2 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-30px, -20px) scale(1.15); }
    }
    @media (prefers-reduced-motion: reduce) {
      .glow { animation: none; }
    }
    #reset-status.error { color: #E8845A; }
    #reset-status.success { color: #7C9A73; }
  </style>

  <script>
    import { supabaseBrowser } from '../../lib/supabaseClient';

    const loadingState = document.getElementById('loading-state')!;
    const resetForm = document.getElementById('reset-form') as HTMLFormElement;
    const invalidLink = document.getElementById('invalid-link')!;
    const resetStatus = document.getElementById('reset-status')!;
    const resetSubmit = document.getElementById('reset-submit') as HTMLButtonElement;

    // Supabase fires a PASSWORD_RECOVERY event once it picks up the token
    // from the URL hash. Give it a moment; if it never fires, the link was
    // invalid or expired.
    let resolved = false;

    supabaseBrowser.auth.onAuthStateChange((event) => {
      if (event === 'PASSWORD_RECOVERY') {
        resolved = true;
        loadingState.classList.add('hidden');
        resetForm.classList.remove('hidden');
      }
    });

    setTimeout(() => {
      if (!resolved) {
        loadingState.classList.add('hidden');
        invalidLink.classList.remove('hidden');
      }
    }, 3000);

    // Password visibility toggle
    const passwordInput = document.getElementById('new-password') as HTMLInputElement;
    const toggleBtn = document.getElementById('toggle-password')!;
    const eyeIcon = document.getElementById('eye-icon')!;
    const eyeOffIcon = document.getElementById('eye-off-icon')!;

    toggleBtn.addEventListener('click', () => {
      const isHidden = passwordInput.type === 'password';
      passwordInput.type = isHidden ? 'text' : 'password';
      eyeIcon.classList.toggle('hidden', isHidden);
      eyeOffIcon.classList.toggle('hidden', !isHidden);
      toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
    });

    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      resetSubmit.disabled = true;
      resetStatus.textContent = '';
      resetStatus.classList.remove('error', 'success');

      const { error } = await supabaseBrowser.auth.updateUser({ password: passwordInput.value });

      if (error) {
        resetStatus.textContent = 'Could not update password. Try again.';
        resetStatus.classList.add('error');
        resetSubmit.disabled = false;
        return;
      }

      resetStatus.textContent = 'Password updated! Redirecting…';
      resetStatus.classList.add('success');
      setTimeout(() => {
        window.location.href = '/admin';
      }, 1200);
    });
  </script>
</AdminLayout>
