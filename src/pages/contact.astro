---
import Layout from '../layouts/Layout.astro';
import PhotoCard from '../components/PhotoCard.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Dosis Kardia Foundation in Port Harcourt, Nigeria."
>
  <section class="pt-40 pb-20 px-6 max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-start">
    <div class="md:sticky md:top-32">
      <h1 class="font-display text-4xl text-umber font-semibold mb-4">Get in touch</h1>
      <p class="text-ink/70 mb-6">
        Questions about our work, partnership, or how to help? Reach out.
      </p>
      <PhotoCard src="/images/contact/contact-hero.jpg" alt="Dosis Kardia Foundation team at work" aspect="aspect-[4/3]" />
      <div class="text-sm text-ink/60 mt-6 space-y-1">
        <p>Port Harcourt, Nigeria</p>
        <p>givingheartfoundation.ghf@gmail.com</p>
      </div>
    </div>

    <div>
    <form id="contact-form" class="bg-white/70 border border-umber/10 rounded-2xl p-8 space-y-5">
      <div>
        <label for="c-name" class="block text-sm font-medium text-umber mb-1.5">Name</label>
        <input id="c-name" name="name" type="text" required
          class="w-full rounded-lg border border-umber/15 px-4 py-2.5 bg-ivory focus:outline-none focus:ring-2 focus:ring-clay" />
      </div>
      <div>
        <label for="c-email" class="block text-sm font-medium text-umber mb-1.5">Email</label>
        <input id="c-email" name="email" type="email" required
          class="w-full rounded-lg border border-umber/15 px-4 py-2.5 bg-ivory focus:outline-none focus:ring-2 focus:ring-clay" />
      </div>
      <div>
        <label for="c-message" class="block text-sm font-medium text-umber mb-1.5">Message</label>
        <textarea id="c-message" name="message" rows="5" required
          class="w-full rounded-lg border border-umber/15 px-4 py-2.5 bg-ivory focus:outline-none focus:ring-2 focus:ring-clay"></textarea>
      </div>
      <button type="submit" id="contact-submit"
        class="w-full bg-clay text-ivory py-3.5 rounded-full font-semibold hover:bg-umber transition-colors disabled:opacity-50">
        Send message
      </button>
      <p id="contact-status" class="text-sm text-center min-h-5" aria-live="polite"></p>
    </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form');
    const statusEl = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      statusEl.textContent = '';

      const payload = {
        name: document.getElementById('c-name').value,
        email: document.getElementById('c-email').value,
        message: document.getElementById('c-message').value,
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.success) {
          statusEl.textContent = "Thanks — we'll get back to you soon.";
          statusEl.classList.add('text-olive');
          form.reset();
        } else {
          statusEl.textContent = 'Something went wrong. Please try again.';
          statusEl.classList.add('text-clay');
        }
      } catch {
        statusEl.textContent = 'Something went wrong. Please try again.';
        statusEl.classList.add('text-clay');
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
