---
import Layout from '../layouts/Layout.astro';
import PhotoCard from '../components/PhotoCard.astro';
---

<Layout
  title="Impact"
  description="See the impact Dosis Kardia Foundation has made, reaching over 350 vulnerable children and young people."
>
  <section class="pt-40 pb-16 px-6 max-w-3xl mx-auto text-center">
    <h1 class="font-display text-4xl md:text-5xl text-umber font-semibold">
      The power of giving.
    </h1>
  </section>

  <!-- Stat block: the two hard figures we do have. Once the client shares
       more (meals served, dates, etc.), add more <div> blocks here following
       the same markup, and reuse the same count-up script as the homepage. -->
  <section class="max-w-4xl mx-auto px-6 pb-16 text-center">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12 max-w-3xl mx-auto reveal-group" id="impact-page-counters">
      <div class="reveal">
        <p class="font-display text-6xl text-clay counter" data-target="350">0</p>
        <p class="text-sm text-ink/60 mt-2">young people reached</p>
      </div>
      <div class="reveal">
        <p class="font-display text-6xl text-clay counter" data-target="4">0</p>
        <p class="text-sm text-ink/60 mt-2">years of consistent outreach</p>
      </div>
      <div class="reveal">
        <p class="font-display text-6xl text-clay counter" data-target="15" data-suffix="+">0</p>
        <p class="text-sm text-ink/60 mt-2">medical outreaches carried out</p>
      </div>
      <div class="reveal">
        <p class="font-display text-6xl text-clay counter" data-target="100" data-suffix="%">0</p>
        <p class="text-sm text-ink/60 mt-2">school fees paid</p>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-24 text-ink/75 leading-relaxed space-y-5">
    <p class="reveal">
      For four years now, Dosis Kardia Foundation has been reaching out to
      vulnerable children and young people, over 350 so far, including those
      living on the streets, homeless and otherwise, with no parental care
      or support.
    </p>

    <div class="grid sm:grid-cols-2 gap-4 reveal-group">
      <PhotoCard class="reveal" src="/images/impact/gallery-1.jpg" alt="Food distribution to children" aspect="aspect-[4/3]" />
      <PhotoCard class="reveal" src="/images/impact/gallery-2.jpg" alt="Children with learning materials" aspect="aspect-[4/3]" />
    </div>

    <p class="reveal">
      We teach and disciple them in the Word of God, clothe and feed them,
      and attend to their medical needs. We have also supported access to
      education by providing learning materials and guidance, and by
      giving scholarships to children who need help staying in school. We
      also partner with other children's homes to reach even more children.
    </p>
    <p class="reveal">
      Through our regular visits, we have facilitated access to basic
      healthcare, addressing urgent medical needs and promoting overall
      well-being.
    </p>

    <PhotoCard
      class="reveal"
      src="/images/impact/gallery-3.jpg"
      alt="A child receiving medical care"
      aspect="aspect-[16/7]"
    />
  </section>

  <script>
    // Same scroll-triggered count-up used on the homepage.
    const counters = document.querySelectorAll<HTMLElement>('.counter');
    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      if (!target) return; // no real figure yet, leave as 0 placeholder
      const duration = 1400;
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        el.textContent = Math.floor(progress * target).toLocaleString() + (el.dataset.suffix || '');
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );

    counters.forEach((c) => observer.observe(c));
  </script>
</Layout>
