---
import Layout from '../layouts/Layout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { BookOpen, UtensilsCrossed, Home, Stethoscope, HandHeart, HeartPulse, ArrowRight } from '@lucide/astro';

const pillars = [
  { name: 'Education', blurb: 'Building minds and opening doors to school.', icon: BookOpen },
  { name: 'Food & Clothing', blurb: 'Meeting daily needs, one meal and one outfit at a time.', icon: UtensilsCrossed },
  { name: 'Shelter', blurb: 'A safe place to call home.', icon: Home },
  { name: 'Medical Care', blurb: 'Health and healing for a brighter future.', icon: Stethoscope },
  { name: 'Discipleship', blurb: 'Teaching and mentoring through the Word of God.', icon: HandHeart },
];
---

<Layout
  title="Home"
  description="Dosis Kardia Foundation gives vulnerable, street-connected children in Port Harcourt, Nigeria access to education, food, shelter, medical care, and mentorship."
>
  <!-- Hero -->
  <section class="relative overflow-hidden pt-40 pb-28 px-6 text-center bg-ivory">
    <p class="font-script text-clay text-2xl mb-2">Hope for a Lifetime</p>
    <h1 class="font-display text-4xl md:text-6xl font-semibold text-umber max-w-3xl mx-auto leading-tight">
      Every child deserves a heartbeat that's heard.
    </h1>
    <p class="mt-6 text-lg text-ink/70 max-w-xl mx-auto">
      For four years, we've walked alongside street-connected children and
      young people in Port Harcourt, giving them a path back to dignity
      through education, food, clothing, shelter, medical care, and
      discipleship in God's Word.
    </p>

    <div class="mt-9 flex items-center justify-center gap-4">
      <a href="/donate" class="bg-clay text-ivory px-7 py-3 rounded-full font-semibold hover:bg-umber transition-colors">
        Donate now
      </a>
      <a href="/about" class="text-umber font-semibold px-7 py-3 rounded-full border border-umber/20 hover:bg-umber/5 transition-colors">
        Learn more
      </a>
    </div>

    <!-- Photo slideshow, with the heartbeat mark as a small accent badge -->
    <div class="mt-16 max-w-5xl mx-auto px-6 relative">
      <HeroSlideshow />
      <div
        class="heartbeat absolute -top-6 -right-2 md:right-6 w-16 h-16 md:w-20 md:h-20 rounded-full bg-marigold flex items-center justify-center drop-shadow-lg"
        aria-hidden="true"
      >
        <HeartPulse size={32} stroke-width={2} class="text-umber md:w-9 md:h-9" />
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section class="max-w-5xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <h2 class="font-display text-3xl text-umber mb-4">Who we are</h2>
      <p class="text-ink/75 leading-relaxed">
        Dosis Kardia Foundation is a faith-driven non-profit reaching
        vulnerable young people living on the streets, homeless and
        otherwise, with no parental care or support. For four years, the
        Agagu Family has led us in visiting them consistently: teaching and
        discipling them in God's Word, clothing and feeding them, tending to
        their medical needs, and sponsoring some through school. We go
        beyond temporary relief to build lasting stability, identity, and
        purpose, one child at a time.
      </p>
      <a href="/about" class="inline-flex items-center gap-1.5 mt-6 text-clay font-semibold hover:text-umber transition-colors group">
        Read our full story
        <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
      </a>
    </div>
    <div class="rounded-2xl overflow-hidden">
      <PhotoCard src="/images/home/who-we-are.jpg" alt="Children supported by Dosis Kardia Foundation" />
    </div>
  </section>

  <!-- Pillars -->
  <section class="bg-umber py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-display text-3xl text-ivory mb-2 text-center">What we do</h2>
      <p class="text-ivory/60 text-center mb-12 max-w-lg mx-auto">
        Five ways we meet a child's needs, in body, mind, and spirit.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {pillars.map((pillar) => (
          <div class="bg-ivory/5 border border-ivory/10 rounded-2xl p-6 hover:bg-ivory/10 hover:-translate-y-1 transition-all duration-300">
            <div class="text-marigold mb-4">
              <pillar.icon size={32} stroke-width={1.75} />
            </div>
            <h3 class="font-display text-lg text-ivory mb-2">{pillar.name}</h3>
            <p class="text-ivory/60 text-sm leading-relaxed">{pillar.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impact counters -->
  <!-- Once the client shares hard figures (children reached, meals served, etc.),
       add more <div> blocks here following the same markup as the counter below. -->
  <section class="max-w-5xl mx-auto px-6 py-24 text-center">
    <h2 class="font-display text-3xl text-umber mb-3">Four years of showing up</h2>
    <p class="text-ink/70 max-w-xl mx-auto mb-14">
      For four years now, we've been visiting street-connected young people,
      homeless and otherwise: teaching and discipling them in God's Word,
      feeding and clothing them, attending to their medical needs, and
      sponsoring some through school.
    </p>
    <div class="grid place-items-center" id="impact-counters">
      <div>
        <p class="font-display text-6xl text-clay counter" data-target="4">0</p>
        <p class="text-sm text-ink/60 mt-2">years of consistent outreach</p>
      </div>
    </div>
  </section>

  <!-- Donate CTA band -->
  <section class="bg-clay py-20 px-6 text-center">
    <h2 class="font-display text-3xl md:text-4xl text-ivory mb-4">
      Your support can change a child's story.
    </h2>
    <p class="text-ivory/85 max-w-xl mx-auto mb-8">
      Give a child not just food or shelter, but hope, direction, and a future.
    </p>
    <a href="/donate" class="inline-block bg-ivory text-clay px-8 py-3.5 rounded-full font-semibold hover:bg-umber hover:text-ivory transition-colors">
      Donate today
    </a>
  </section>

  <script>
    // Scroll-triggered count-up: runs once, only when the section enters view
    const counters = document.querySelectorAll<HTMLElement>('.counter');
    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      if (!target) return; // no real figure yet, leave as 0 placeholder
      const duration = 1400;
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        el.textContent = Math.floor(progress * target).toLocaleString();
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );

    counters.forEach((c) => observer.observe(c));
  </script>
</Layout>
